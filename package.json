{
  "name": "erasmusinbarcelona",
  "version": "1.0.0",
  "private": true,
  "description": "ErasmusInBarcelona.com — Erasmus+ KA1 staff training in Barcelona, by SpainBcn-Programs",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:live": "node build.mjs && node tools/build-htaccess.mjs",
    "build:pages": "BASE_PATH=/ErasmusInBarcelona SITE_URL=https://rahv-fb.github.io/ErasmusInBarcelona PROTOTYPE=1 node build.mjs",
    "images": "node tools/build-images.mjs",
    "dates": "node tools/refresh-dates.mjs",
    "start": "node build.mjs && node server.mjs",
    "serve": "node server.mjs",
    "guards": "node build.mjs && node tools/build-htaccess.mjs && node scripts/guards.mjs",
    "check": "node scripts/health-check.mjs",
    "links": "node scripts/link-check.mjs"
  },
  "devDependencies": {
    "playwright": "^1.49.0",
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": ">=18"
  }
}
